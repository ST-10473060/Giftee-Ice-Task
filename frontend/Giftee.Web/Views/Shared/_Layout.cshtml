<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Giftee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-dark giftee-nav mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🎁 Giftee</a>
            <div class="d-flex gap-3">
                <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link text-white fw-semibold" asp-controller="Gifts" asp-action="Index">Find a gift</a>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <footer class="text-center text-muted py-4 small">Giftee – find the perfect gift</footer>
</body>
</html>